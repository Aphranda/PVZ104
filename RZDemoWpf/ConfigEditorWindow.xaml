<Window x:Class="RZDemoWpf.ConfigEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="参数配置"
        Width="1040"
        Height="720"
        MinWidth="920"
        MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <Grid Background="{StaticResource BrushSurface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#26323F" Padding="18,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="参数配置"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding ConfigPathText}"
                           Foreground="#C8D0DA"
                           FontSize="12"
                           Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding ConfigPathText}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="配置目标" />
                    <TextBlock Style="{StaticResource LabelStyle}" Text="项目型号" />
                    <ComboBox ItemsSource="{Binding ProjectItems}"
                              SelectedItem="{Binding SelectedProjectItemNumber}"
                              Margin="0,6,0,12" />
                    <TextBlock Style="{StaticResource LabelStyle}" Text="轴" />
                    <ComboBox ItemsSource="{Binding AxisItems}"
                              SelectedItem="{Binding SelectedAxis}"
                              Margin="0,6,0,14" />
                    <UniformGrid Columns="2">
                        <Button Content="重新加载" Command="{Binding ReloadCommand}" Margin="0,0,6,0" />
                        <Button Content="保存 JSON" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="6,0,0,0" />
                    </UniformGrid>
                    <Separator Margin="0,16,0,12" />
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="新增项目" />
                    <TextBlock Style="{StaticResource LabelStyle}" Text="新项目型号" />
                    <TextBox Text="{Binding NewProjectItemNumber, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,6,0,10" />
                    <Button Content="复制当前项目新增"
                            Command="{Binding AddProjectCommand}" />
                    <Separator Margin="0,16,0,12" />
                    <TextBlock Style="{StaticResource LabelStyle}" Text="状态" />
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{Binding StatusBrush}"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0" />
                    <Separator Margin="0,16,0,12" />
                    <TextBlock Style="{StaticResource LabelStyle}"
                               Text="修改后需断开并重新连接/初始化，底层才会按新参数重新下发。"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Expander Header="电机基础" IsExpanded="True" Margin="0,0,0,10">
                        <Border Style="{StaticResource PanelBorderStyle}" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="scale" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding BaseScaleText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,8" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="smooth" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding BaseSmoothText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="encoder" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EncoderText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,8" />
                                <CheckBox Grid.Row="2" Grid.Column="1" Content="正限位低电平" IsChecked="{Binding PosLmtDown}" Margin="0,4,14,0" />
                                <CheckBox Grid.Row="2" Grid.Column="3" Content="负限位低电平" IsChecked="{Binding NegLmtDown}" Margin="0,4,0,0" />
                            </Grid>
                        </Border>
                    </Expander>

                    <Expander Header="回零参数" IsExpanded="True" Margin="0,0,0,10">
                        <Border Style="{StaticResource PanelBorderStyle}" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="homeMode" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding HomeModeText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,8" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="dir" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding HomeDirText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="acc" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding HomeAccText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,8" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="scan1stVel" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding HomeScan1stVelText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="scan2ndVel" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding HomeScan2ndVelText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,8" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="reScanEn" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding HomeReScanEnText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="homeEdge" VerticalAlignment="Center" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding HomeEdgeText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,8" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="lmtEdge" VerticalAlignment="Center" />
                                <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding HomeLmtEdgeText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="zEdge" VerticalAlignment="Center" />
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding HomeZEdgeText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,8" />
                                <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="iniRetPos" VerticalAlignment="Center" />
                                <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding HomeIniRetPosText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="retSwOffset" VerticalAlignment="Center" />
                                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding HomeRetSwOffsetText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,8" />
                                <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="safeLen" VerticalAlignment="Center" />
                                <TextBox Grid.Row="5" Grid.Column="3" Text="{Binding HomeSafeLenText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="usePreSetPtpPara" VerticalAlignment="Center" />
                                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding HomeUsePreSetPtpParaText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,0" />
                            </Grid>
                        </Border>
                    </Expander>

                    <Expander Header="点动与定位" IsExpanded="True" Margin="0,0,0,10">
                        <Border Style="{StaticResource PanelBorderStyle}" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="jog acc" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding JogAccText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,8" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="jog dec" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding JogDecText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="jog smooth" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding JogSmoothText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,8" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="move acc" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MoveAccText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,8" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="move dec" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding MoveDecText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="move smooth" VerticalAlignment="Center" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MoveSmoothText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,0" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="start/end vel" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal">
                                    <TextBox Text="{Binding MoveStartVelText, UpdateSourceTrigger=PropertyChanged}" Width="92" Margin="0,0,8,0" />
                                    <TextBox Text="{Binding MoveEndVelText, UpdateSourceTrigger=PropertyChanged}" Width="92" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Expander>

                    <Expander Header="触发参数" IsExpanded="False" Margin="0,0,0,10">
                        <Border Style="{StaticResource PanelBorderStyle}" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="outputChn" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TriggerOutputChnText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,8" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="outputType" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding TriggerOutputTypeText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="chnType" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TriggerChnTypeText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,8" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="posSrc" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding TriggerPosSrcText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="dir1No" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TriggerDir1NoText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,8" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="dir2No" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding TriggerDir2NoText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="stLevel" VerticalAlignment="Center" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TriggerStLevelText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,8" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="errZone" VerticalAlignment="Center" />
                                <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding TriggerErrZoneText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="directOutZone" VerticalAlignment="Center" />
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding TriggerDirectOutZoneText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,8" />
                                <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="vibrateRange" VerticalAlignment="Center" />
                                <TextBox Grid.Row="4" Grid.Column="3" Text="{Binding TriggerVibrateRangeText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="gateTime" VerticalAlignment="Center" />
                                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding TriggerGateTimeText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,0" />
                                <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="minIntervalTime" VerticalAlignment="Center" />
                                <TextBox Grid.Row="5" Grid.Column="3" Text="{Binding TriggerMinIntervalTimeText, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>
                    </Expander>

                    <Expander Header="线性补偿" IsExpanded="False" Margin="0,0,0,10">
                        <Border Style="{StaticResource PanelBorderStyle}" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <CheckBox Grid.Row="0" Grid.Column="1" Content="启用线性补偿" IsChecked="{Binding LinearEnabled}" Margin="0,4,14,8" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="scale_factor" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LinearScaleFactorText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,0" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="scale_offset" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding LinearScaleOffsetText, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>
                    </Expander>

                    <Expander Header="离散补偿" IsExpanded="False">
                        <Border Style="{StaticResource PanelBorderStyle}" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="num" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DiscreteNumText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,8" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="startPos" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding DiscreteStartPosText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="cmpLen" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DiscreteCmpLenText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,8" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="pCmpPos" VerticalAlignment="Top" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DiscretePCmpPosText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,0" Height="92" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="nCmpPos" VerticalAlignment="Top" />
                                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding DiscreteNCmpPosText, UpdateSourceTrigger=PropertyChanged}" Height="92" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </Border>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="#E6EAF0" Padding="16,0">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{Binding StatusBrush}"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
